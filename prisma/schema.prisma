// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  USER
  ADMIN
}

enum MarketType {
  BINARY
}

enum OutcomeStatus {
  ACTIVE
  INACTIVE
  RESOLVED
}

enum AmmCurve {
  CPMM
  LMSR
}

enum OrderPosition {
  YES
  NO
}

model Event {
  id          String   @id @default(cuid())
  question    String
  description String?
  bettingCloseAt DateTime
  resolveAt   DateTime?
  feeBps      Int      @default(100)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator User    @relation(fields: [createdBy], references: [id])
  markets Market[]

  @@index([createdBy])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  role      UserRole @default(USER)

  wallet    Wallet?
  events    Event[]
  markets   Market[]
  orders    Order[]
  positions Position[]
  positionLots PositionLot[]
  achievements UserAchievement[]
  walletLedgerEntries WalletLedger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AchievementDefinition {
  id          String   @id @default(cuid())
  number      Int      @unique
  code        String   @unique
  title       String
  description String?
  reward      Int
  category    String
  targetValue Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userAchievements UserAchievement[]

  @@index([isActive, number])
  @@index([category, targetValue])
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  rewardGranted Int
  createdAt     DateTime @default(now())

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement AchievementDefinition @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
}

model WalletLedger {
  id            String   @id @default(cuid())
  userId        String
  amount        Int
  reason        String
  referenceType String?
  referenceId   String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(1000)
  locked    Int      @default(0)

  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Market {
  id          String     @id @default(cuid())
  eventId     String
  question    String
  description String?
  status      String
  type        MarketType @default(BINARY)
  bettingCloseAt DateTime
  resolveAt      DateTime?
  resolvedOutcomeId String?
  resolvedPosition  OrderPosition?

  createdBy String
  createdAt DateTime @default(now())

  orders     Order[]
  positions  Position[]
  positionLots PositionLot[]
  liquidity  MarketLiquidity?
  outcomes   Outcome[]
  ammConfig  MarketAmmConfig?

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [createdBy], references: [id])

  @@index([status])
  @@index([bettingCloseAt])
  @@index([type])
  @@index([eventId])
}

model MarketLiquidity {
  id       String @id @default(cuid())
  marketId String @unique
  yesPool  Float  @default(0)
  noPool   Float  @default(0)
  feeBps   Int    @default(100)

  market Market @relation(fields: [marketId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Outcome {
  id        String        @id @default(cuid())
  marketId  String
  slug      String
  label     String
  position  Int
  status    OutcomeStatus @default(ACTIVE)
  createdAt DateTime      @default(now())

  market    Market            @relation(fields: [marketId], references: [id], onDelete: Cascade)
  liquidity OutcomeLiquidity?
  positions Position[]
  positionLots PositionLot[]

  @@unique([marketId, slug])
  @@index([marketId, position])
}

model Position {
  id        String        @id @default(cuid())
  userId    String
  marketId  String
  outcomeId String
  position  OrderPosition
  shares    Float         @default(0)
  costBasis Float         @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  market  Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  outcome Outcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)

  @@unique([userId, marketId, outcomeId, position])
  @@index([userId])
  @@index([marketId])
}


model PositionLot {
  id              String        @id @default(cuid())
  userId          String
  marketId        String
  outcomeId       String
  position        OrderPosition
  buyOrderId      String        @unique
  openedShares    Float
  remainingShares Float
  entryPrice      Float
  entryGrossAmount Float
  entryFee        Float
  entryNetAmount  Float
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  market  Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  outcome Outcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  buyOrder Order  @relation("BuyOrderLots", fields: [buyOrderId], references: [id], onDelete: Cascade)
  lotCloses LotClose[]

  @@index([userId, marketId, outcomeId, position])
  @@index([marketId])
}

model LotClose {
  id          String   @id @default(cuid())
  sellOrderId String
  buyLotId    String
  closedShares Float
  grossAmount Float
  feeAmount   Float
  netAmount   Float
  createdAt   DateTime @default(now())

  sellOrder Order      @relation("SellOrderCloses", fields: [sellOrderId], references: [id], onDelete: Cascade)
  buyLot    PositionLot @relation(fields: [buyLotId], references: [id], onDelete: Cascade)

  @@index([sellOrderId])
  @@index([buyLotId])
}

model MarketAmmConfig {
  id        String   @id @default(cuid())
  marketId  String   @unique
  curve     AmmCurve @default(CPMM)
  feeBps    Int      @default(100)
  lmsrB     Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
}

model OutcomeLiquidity {
  id        String   @id @default(cuid())
  outcomeId String   @unique
  yesPool   Float    @default(0)
  noPool    Float    @default(0)
  updatedAt DateTime @updatedAt

  outcome   Outcome  @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
}

model Order {
  id        String   @id
  userId    String
  marketId  String
  outcomeId String
  side      String
  position  OrderPosition?
  price     Float
  amount    Float
  status    String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  market Market @relation(fields: [marketId], references: [id])
  buyLots PositionLot[] @relation("BuyOrderLots")
  lotCloses LotClose[] @relation("SellOrderCloses")

  @@index([marketId])
  @@index([userId])
}

    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".test-dist",
    "rootDir": "src",
    "declaration": false,
    "incremental": false,
    "tsBuildInfoFile": ".test-dist/.tsbuildinfo",
    "types": [
      "node"
    ]
